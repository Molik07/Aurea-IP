# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Frontend URL (set after Vercel deploy — used for CORS allowlist) ─────────
# Example: https://aurea.vercel.app
FRONTEND_URL=

# ─── PostgreSQL (Prisma) ──────────────────────────────────────────────────────
# Railway PostgreSQL plugin connection string (copy from Railway dashboard)
# Example: postgresql://postgres:password@containers-us-west-xxx.railway.app:7890/railway
DATABASE_URL=

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# MongoDB Atlas free cluster connection string
# Example: mongodb+srv://user:password@cluster0.abc.mongodb.net/makeup_store
MONGODB_URI=

# ─── Redis ────────────────────────────────────────────────────────────────────
# Upstash Redis URL (recommended for Railway / serverless)
# Example: redis://default:password@us1-xxx.upstash.io:6379
REDIS_URL=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate secure secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Cloudinary (Image Uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase (Phone / Google Auth) ───────────────────────────────────────────
# Paste the entire service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
