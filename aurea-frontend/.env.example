# ─── Frontend API ─────────────────────────────────────────────────────────────
# In development: leave empty (Vite proxy handles /api requests locally)
# In production (Vercel): set to your Railway backend URL
# Example: VITE_API_BASE_URL=https://backend-production-xxxx.up.railway.app
VITE_API_BASE_URL=

# ─── Cloudinary (Image Uploads) ───────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ─── Firebase (Phone / Google Auth) ───────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
